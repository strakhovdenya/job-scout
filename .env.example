# JobScout environment variables.
# Copy to .env.local (web) or export in your shell. Never commit real values.
# The current foundation runs without any of these variables.

# Google Cloud (future: Firestore, Cloud Run, Secret Manager)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# AI providers (future: screening). Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Screening model identifiers (future). Set explicitly; no model ID is hardcoded.
JOBSCOUT_SCREENING_MODEL=

# Authentication (future: Auth.js with Google OAuth)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Worker
JOBSCOUT_ENVIRONMENT=local
