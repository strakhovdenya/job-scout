{
  "name": "@job-scout/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent JobScout domain contracts and shared business logic.",
  "type": "module",
  "exports": {
    ".": {
      "@job-scout/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
