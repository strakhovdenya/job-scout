{
  "name": "@job-scout/firestore",
  "version": "0.0.0",
  "private": true,
  "description": "Firestore adapter boundary for JobScout with emulator safeguards, seeding and reset.",
  "type": "module",
  "exports": {
    ".": {
      "@job-scout/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "node --conditions=@job-scout/source --env-file=../../config/local.env --env-file-if-exists=../../.env --import ../../scripts/require-local.ts src/cli/seed.ts",
    "reset": "node --conditions=@job-scout/source --env-file=../../config/local.env --env-file-if-exists=../../.env --import ../../scripts/require-local.ts src/cli/reset.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@job-scout/core": "workspace:*"
  }
}
