# JobScout environment variables.
# Optional: copy to the repository-root .env and uncomment only needed overrides.
# config/local.env already supplies all required local defaults.
# JOBSCOUT_ENV=local
# GOOGLE_CLOUD_PROJECT=demo-job-scout
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# JOBSCOUT_PROVIDER_MODE=offline
# JOBSCOUT_MOCK_AUTH=false

# AI providers (future: screening). Server-side only. Never prefix with NEXT_PUBLIC_.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Screening model identifiers (future). Set explicitly; no model ID is hardcoded.
# JOBSCOUT_SCREENING_MODEL=
# JOBSCOUT_AI_MAX_REQUESTS_PER_RUN=
# JOBSCOUT_AI_MAX_TOKENS_PER_RUN=

# Authentication (future: Auth.js with Google OAuth)
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
